# Tribunal — the environment a deliberation needs.
#
# Copy to .env for local work. .env is git-ignored and never committed.
# In production the same names are set in the Netlify UI, not in this repo.
# This file carries names and non-secret values only.

# --- OpenRouter -------------------------------------------------------------
# The only model provider. One key reaches every model, so changing a model
# below needs no new account and no new key.
OPENROUTER_API_KEY=

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=

# Server only. This key bypasses row-level security, so it never reaches the
# browser and never appears in client code.
SUPABASE_SECRET_KEY=

# Browser-safe. Nothing uses it yet: row-level security is on and no policy is
# defined, so every read goes through the server. Uncomment if that changes.
# SUPABASE_PUBLISHABLE_KEY=

# --- The panel --------------------------------------------------------------
# One model per agent. Seven agents, seven settings, each changeable on its own.
#
# Because no two agents share a model, no agent sees the charge sheet twice in a
# deliberation, and prompt caching saves nothing here. Do not send a cache write
# to buy a read that never comes.
MODEL_ADVOCATE_JON=
MODEL_ADVOCATE_TYRION=
MODEL_ADVOCATE_DAENERYS=
MODEL_ADVOCATE_GREY_WORM=
MODEL_JUDGE_BARAK=
MODEL_JUDGE_ELON=
MODEL_JUDGE_SHAMGAR=

# --- Spend ------------------------------------------------------------------
# What one deliberation may spend, in US dollars. A run that would exceed this
# stops and reports rather than continuing.
MAX_USD_PER_DELIBERATION=0.25

# The eight-call cap is deliberately not here. Seven panel calls and one spare
# is a rule, not a setting, so it lives as a constant in code where it cannot
# be raised by editing an environment.
